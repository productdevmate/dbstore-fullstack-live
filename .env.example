# ===== Required =====
DB_URL=jdbc:postgresql://localhost:5432/daddybazaar
DB_USERNAME=daddybazaar
DB_PASSWORD=daddybazaar

JWT_SECRET=ReplaceThisWithA256BitSecretKeyAtLeast32CharsLongForProduction
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

APP_DOMAIN=daddybazaar.com
FRONTEND_URL=http://localhost:5173
TRIAL_DAYS=14

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Storage =====
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_LOCAL_BASE_URL=http://localhost:8080/files

# --- For S3/Cloudflare R2 (when STORAGE_PROVIDER=s3) ---
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=daddybazaar
STORAGE_REGION=ap-south-1

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_DOMAIN=daddybazaar.com
